---
/**
 * Work card. Poster (AVIF/WebP, lazy, fixed aspect → zero CLS) over an LQIP.
 * The muted preview loop is controlled by previews.ts (hover on desktop,
 * most-visible card on touch, never under reduced motion / Save-Data).
 * Clicking opens the lightbox (Lightbox.astro) with the full video.
 */
import type { Work } from '../lib/works';

interface Props {
  work: Work;
  index?: number;
  class?: string;
  eager?: boolean;
}
const { work: w, index = 0, class: cls = '', eager = false } = Astro.props;
const m = w.media;
const vertical = w.aspect === '9:16';
const full = w.full;
const meta = [w.client, w.views].filter(Boolean);
---

<article
  class:list={['work-card group', cls]}
  data-work-card
  data-category={w.category}
  style={`view-transition-name: work-${w.slug}; --i:${index % 5}`}
  data-reveal
>
  <button
    type="button"
    class="group/btn block w-full cursor-pointer text-left"
    aria-haspopup="dialog"
    aria-label={`Play ${w.title}`}
    data-cursor="play"
    data-open-work
    data-title={w.title}
    data-aspect={w.aspect}
    data-full-kind={full?.kind ?? 'none'}
    data-full-id={full?.kind === 'youtube' ? full.id : undefined}
    data-full-src={full?.kind === 'url' ? full.src : undefined}
    data-owner={full?.owner}
    data-preview-mp4={m?.preview.mp4}
    data-preview-webm={m?.preview.webm}
    data-poster={m?.poster.webp}
  >
    <div
      class="frame relative overflow-hidden rounded-md bg-surface bg-cover bg-center ring-1 ring-line transition-shadow duration-500 ring-inset group-hover:ring-line-strong"
      style={`aspect-ratio:${vertical ? '9/16' : '16/9'};${m ? `background-image:url(${m.lqip})` : ''}`}
    >
      {
        m && (
          <picture>
            <source type="image/avif" srcset={m.poster.avif} />
            <img
              src={m.poster.webp}
              width={m.width}
              height={m.height}
              alt=""
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
              class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-[1.03]"
            />
          </picture>
        )
      }
      {
        m && (
          <video
            class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500"
            muted
            loop
            playsinline
            preload="none"
            disablepictureinpicture
            disableremoteplayback
            tabindex="-1"
            aria-hidden="true"
            data-preview
          >
            <source src={m.preview.webm} type="video/webm" />
            <source src={m.preview.mp4} type="video/mp4" />
          </video>
        )
      }

      <!-- Overlay chrome -->
      <div
        class="pointer-events-none absolute inset-0 bg-linear-to-t from-ink/70 via-transparent to-ink/30"
        aria-hidden="true"
      >
      </div>
      <span
        class="absolute top-3 left-3 rounded-full border border-fg/15 bg-ink/50 px-2.5 py-1 font-mono text-[10px] tracking-widest text-fg uppercase backdrop-blur-md"
      >
        {w.categoryLabel}
      </span>
      {
        m && (
          <span class="absolute right-3 bottom-3 font-mono text-[11px] text-fg/85 tabular-nums">
            {m.durationLabel}
          </span>
        )
      }
      <span
        class="absolute inset-0 m-auto grid size-14 scale-90 place-items-center rounded-full bg-fg/90 text-ink opacity-0 transition duration-300 ease-out-quart group-hover:scale-100 group-hover:opacity-100 group-focus-visible/btn:scale-100 group-focus-visible/btn:opacity-100"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="ml-0.5 size-5" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>
      </span>
    </div>
  </button>

  <div class="mt-3 flex items-start justify-between gap-3">
    <h3 class="text-[15px] leading-snug font-medium tracking-[-0.01em]">{w.title}</h3>
    {
      w.views && (
        <span class="shrink-0 font-mono text-[11px] text-ember tabular-nums">{w.views}</span>
      )
    }
  </div>
  {meta.length > 0 && w.client && <p class="mt-1 text-sm text-muted">{w.client}</p>}
</article>
