---
/**
 * Final CTA + contact.
 * - Email: mailto + copy-to-clipboard (copy needs JS; mailto works without).
 * - Calendly: external link.
 * - Form: Formspree (POSTs natively without JS; enhanced to inline status with JS).
 * Each piece renders only when its value exists in site.mjs (or in dev, marked).
 */
import { site } from '../data/site.mjs';
import { filled, SHOW_PLACEHOLDERS } from '../lib/placeholder';
import SectionHead from './SectionHead.astro';

const hasEmail = filled(site.email);
const hasCal = filled(site.calendly);
const hasForm = filled(site.formspreeId);
const showEmail = hasEmail || SHOW_PLACEHOLDERS;
const showCal = hasCal || SHOW_PLACEHOLDERS;
const showForm = hasForm || SHOW_PLACEHOLDERS;
const email = hasEmail ? site.email : 'you@example.com';
const action = hasForm ? `https://formspree.io/f/${site.formspreeId}` : '#';
const field =
  'w-full rounded-md border border-line-strong bg-surface px-4 py-3 text-[15px] text-fg placeholder:text-faint transition-colors hover:border-faint focus:border-fg focus:outline-none';
---

<section id="contact" class="relative overflow-hidden border-t border-line py-24 md:py-36" aria-labelledby="contact-title">
  <div class="container-x">
    <SectionHead track="OUT" label="Contact" tc="00:02:10:00" />
    <h2 id="contact-title" class="mt-12 max-w-[16ch] text-display font-medium md:mt-16" data-reveal>
      Let's make your next video your <span class="serif text-ember">best</span> one.
    </h2>

    <div class="mt-14 grid gap-14 md:mt-20 md:grid-cols-12 md:gap-6">
      <div class="flex flex-col gap-8 md:col-span-5">
        <p class="max-w-[40ch] text-lg text-muted" data-reveal>
          Tell me about your channel and what you're making. I usually reply within a day.
        </p>

        {
          showEmail && (
            <div class:list={['flex flex-col gap-3', !hasEmail && 'ph']} data-reveal style="--i:1">
              {!hasEmail && <span class="ph-tag">PLACEHOLDER · email · hidden in production</span>}
              <span class="font-mono text-label text-muted uppercase">Email</span>
              <div class="flex flex-wrap items-center gap-3">
                <a href={`mailto:${email}`} class="link-u text-h3 font-medium" data-cursor="view">
                  {email}
                </a>
                <button type="button" class="btn btn-ghost h-9 px-3.5 text-xs" data-copy={email} aria-live="polite">
                  <span data-copy-label>Copy</span>
                </button>
              </div>
            </div>
          )
        }

        {
          showCal && (
            <div class:list={[!hasCal && 'ph']} data-reveal style="--i:2">
              {!hasCal && <span class="ph-tag">PLACEHOLDER · Calendly · hidden in production</span>}
              <a href={hasCal ? site.calendly : '#'} class="btn btn-primary" data-magnetic {...(hasCal && { target: '_blank', rel: 'noopener' })}>
                Book a 20-min call <span aria-hidden="true">↗</span>
              </a>
            </div>
          )
        }
      </div>

      {
        showForm && (
          <form
            class:list={['flex flex-col gap-5 md:col-span-6 md:col-start-7', !hasForm && 'ph']}
            action={action}
            method="POST"
            data-contact-form
            data-reveal
            style="--i:1"
          >
            {!hasForm && <span class="ph-tag">PLACEHOLDER · Formspree ID missing · hidden in production</span>}
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="flex flex-col gap-2">
                <span class="text-sm text-muted">Name</span>
                <input class={field} type="text" name="name" autocomplete="name" required />
              </label>
              <label class="flex flex-col gap-2">
                <span class="text-sm text-muted">Email</span>
                <input class={field} type="email" name="email" autocomplete="email" required />
              </label>
            </div>
            <label class="flex flex-col gap-2">
              <span class="text-sm text-muted">Channel or project link <span class="text-faint">(optional)</span></span>
              <input class={field} type="url" name="channel" inputmode="url" placeholder="https://youtube.com/@…" />
            </label>
            <label class="flex flex-col gap-2">
              <span class="text-sm text-muted">What do you need?</span>
              <select class={field} name="service">
                <option>Long-form YouTube</option>
                <option>Talking-head</option>
                <option>Podcast editing</option>
                <option>Motion graphics & subtitles</option>
                <option>Short-form / Ads</option>
                <option>Something else</option>
              </select>
            </label>
            <label class="flex flex-col gap-2">
              <span class="text-sm text-muted">Message</span>
              <textarea class={`${field} min-h-36 resize-y`} name="message" rows="5" required />
            </label>
            {/* Honeypot (Formspree) */}
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <div class="flex flex-wrap items-center gap-4">
              <button type="submit" class="btn btn-primary" data-magnetic>
                Send message
              </button>
              <p class="text-sm text-muted" role="status" aria-live="polite" data-form-status />
            </div>
          </form>
        )
      }
    </div>
  </div>
</section>

<script>
  // Copy email
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.querySelector<HTMLElement>('[data-copy-label]')!;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        label.textContent = 'Copied ✓';
      } catch {
        label.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (label.textContent = 'Copy'), 2000);
    });
  });

  // Formspree AJAX submit (falls back to a normal POST without JS)
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.getAttribute('action') === '#') {
        status.textContent = 'Formspree ID not set yet (site.mjs → formspreeId).';
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('[type=submit]')!;
      btn.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error();
        form.reset();
        status.textContent = "Thanks — message received. I'll reply soon.";
      } catch {
        status.textContent = 'Something went wrong. Please email me directly.';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
