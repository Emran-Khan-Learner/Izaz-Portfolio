---
/** Timeline-track section header: [V1] LABEL ——— 00:00:12:00 */
interface Props {
  track: string;
  label: string;
  tc?: string;
  id?: string;
}
const { track, label, tc, id } = Astro.props;
---

<div class="flex items-center gap-4 border-t border-line pt-5" data-reveal>
  <span class="track" id={id}><span class="track-id">{track}</span>{label}</span>
  <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
  {tc && <span class="font-mono text-label text-faint tabular-nums" aria-hidden="true">{tc}</span>}
</div>
