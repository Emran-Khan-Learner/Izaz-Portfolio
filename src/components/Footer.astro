---
import { site } from '../data/site.mjs';
import { filled, showValue } from '../lib/placeholder';
import Placeholder from './Placeholder.astro';

const year = new Date().getFullYear();
const socials = site.socials.filter((s) => showValue(s.url));
---

<footer class="border-t border-line">
  <div class="container-x flex flex-col gap-10 py-12 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-3">
      <span class="track"><span class="track-id">END</span> Fade to black</span>
      <p class="text-sm text-muted">© {year} {site.name}. All rights reserved.</p>
    </div>

    {
      socials.length > 0 && (
        <nav aria-label="Social">
          <ul class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
            {socials.map((s) =>
              filled(s.url) ? (
                <li>
                  <a href={s.url} target="_blank" rel="me noopener" class="link-u text-muted hover:text-fg">
                    {s.label}
                  </a>
                </li>
              ) : (
                <Placeholder as="li" note="no URL">
                  <span class="text-muted">{s.label}</span>
                </Placeholder>
              ),
            )}
          </ul>
        </nav>
      )
    }

    <a href="#main" class="group inline-flex items-center gap-2 text-sm text-muted hover:text-fg" data-back-to-top>
      Back to top
      <span
        class="inline-grid size-8 place-items-center rounded-full border border-line-strong transition-colors group-hover:border-fg"
        aria-hidden="true">↑</span
      >
    </a>
  </div>
</footer>
