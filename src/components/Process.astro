---
/**
 * Process as a timeline. Desktop: horizontal track with a playhead (scrubbed
 * by scroll in Stage 4; static at start until then). Mobile: vertical list.
 */
import { process } from '../data/content';
import SectionHead from './SectionHead.astro';
---

<section id="process" class="py-24 md:py-36" aria-labelledby="process-title" data-process>
  <div class="container-x">
    <SectionHead track="V3" label="Process" tc="00:00:48:00" />
    <h2 id="process-title" class="mt-10 max-w-[18ch] text-h2 font-medium md:mt-14" data-reveal>
      A calm, <span class="serif text-muted">predictable</span> edit — every time.
    </h2>

    <div class="relative mt-14 md:mt-24">
      <!-- Timeline ruler (desktop) -->
      <div class="relative hidden h-8 md:block" aria-hidden="true">
        <div class="ruler absolute inset-x-0 bottom-0 h-3"></div>
        <div class="absolute inset-x-0 bottom-0 h-px bg-line-strong"></div>
        <div class="absolute inset-y-0 left-0 w-full origin-left" data-process-progress>
          <div class="absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-ember" data-process-fill></div>
        </div>
        <div class="absolute -bottom-2 left-0 flex flex-col items-center" data-process-head>
          <span class="h-0 w-0 border-x-[6px] border-t-8 border-x-transparent border-t-ember"></span>
          <span class="h-10 w-px bg-ember"></span>
        </div>
      </div>

      <ol class="relative grid gap-0 border-l border-line pl-6 md:grid-cols-5 md:border-l-0 md:pl-0">
        {
          process.map((p, i) => (
            <li class="process-step relative py-6 md:border-l md:border-line md:py-0 md:pt-10 md:pr-6 md:pl-5" data-reveal style={`--i:${i}`} data-step>
              <span class="absolute top-8 left-[-29px] size-2.5 rounded-full border border-line-strong bg-ink md:hidden" aria-hidden="true" />
              <p class="font-mono text-label text-faint tabular-nums">
                <span class="step-num text-muted transition-colors">0{i + 1}</span>
                <span class="mx-2">·</span>
                {p.tc}
              </p>
              <h3 class="mt-4 text-h3 font-medium">{p.title}</h3>
              <p class="mt-3 max-w-[30ch] text-sm leading-relaxed text-muted">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .ruler {
    background-image: repeating-linear-gradient(to right, var(--color-line-strong) 0 1px, transparent 1px 2%);
    mask-image: linear-gradient(to top, #000, transparent);
  }
  .process-step:global(.is-active) .step-num {
    color: var(--color-ember);
  }
</style>
