---
import { site } from '../data/site.mjs';
import { filled, SHOW_PLACEHOLDERS } from '../lib/placeholder';
import { about } from '../data/content';

// Never link to a section that's omitted from the production build.
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#services', label: 'Services' },
  { href: '/#process', label: 'Process' },
  ...(!about.placeholder || SHOW_PLACEHOLDERS ? [{ href: '/#about', label: 'About' }] : []),
];
const bookHref = filled(site.calendly) ? site.calendly : '/#contact';
const bookExternal = filled(site.calendly);
---

<header class="fixed inset-x-0 top-0 z-50">
  <div
    class="absolute inset-0 -z-10 bg-ink/90 md:bg-ink/70 md:backdrop-blur-md"
    aria-hidden="true"
  >
  </div>
  <div class="container-x flex h-16 items-center justify-between gap-6">
    <a href="/" class="group flex items-baseline gap-3">
      <span class="text-[15px] font-semibold tracking-[-0.02em]">{site.shortName}</span>
      <span class="hidden font-mono text-label text-muted uppercase sm:inline">{site.role}</span>
      <span class="sr-only">— home</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm text-muted">
        {
          nav.map((l) => (
            <li>
              <a href={l.href} class="link-u transition-colors hover:text-fg">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={bookHref}
        class="btn btn-primary hidden h-10 px-5 text-sm sm:inline-flex"
        data-magnetic
        {...bookExternal && { target: '_blank', rel: 'noopener' }}
      >
        Book a Call
        {!filled(site.calendly) && SHOW_PLACEHOLDERS && <span class="font-mono text-[9px] text-ember">(TODO)</span>}
      </a>

      <!-- Mobile menu: <details> works with zero JS -->
      <details class="menu relative md:hidden">
        <summary
          class="btn btn-ghost h-10 cursor-pointer list-none px-4 text-sm [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          Menu
        </summary>
        <div
          class="absolute top-12 right-0 w-56 rounded-2xl border border-line-strong bg-surface p-2 shadow-2xl shadow-black/60"
        >
          <ul class="flex flex-col">
            {
              nav.map((l) => (
                <li>
                  <a href={l.href} class="block rounded-xl px-4 py-3 text-[15px] hover:bg-raised">
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/#contact" class="block rounded-xl px-4 py-3 text-[15px] text-ember hover:bg-raised">Contact</a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close mobile menu after picking a link
  document.querySelectorAll<HTMLDetailsElement>('details.menu').forEach((d) => {
    d.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) d.open = false;
    });
  });
</script>
