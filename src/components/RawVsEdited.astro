---
/**
 * Before/after comparison. A native range input drives the split, so it's
 * keyboard- and screen-reader-accessible with no library.
 * Until real clips are set in content.ts → rawVsEdited, a dev-only demo
 * (preview vs. a desaturated "raw" version of the same clip) is shown and
 * the whole section is omitted from production.
 */
import { rawVsEdited } from '../data/content';
import { SHOW_PLACEHOLDERS, filled } from '../lib/placeholder';
import media from '../data/media.json';
import SectionHead from './SectionHead.astro';

const real = !rawVsEdited.placeholder && filled(rawVsEdited.before) && filled(rawVsEdited.after);
const show = real || SHOW_PLACEHOLDERS;
const demo = media.works['ad-01-final'];
const before = real ? rawVsEdited.before : demo?.preview.mp4;
const after = real ? rawVsEdited.after : demo?.preview.mp4;
const poster = demo?.poster.webp;
---

{
  show && before && after && (
    <section id="raw-vs-edited" class="container-x py-24 md:py-36" aria-labelledby="rve-title">
      <SectionHead track="FX" label="Raw vs Edited" tc="00:01:04:00" />
      <div class="mt-10 grid gap-6 md:mt-14 md:grid-cols-12">
        <h2 id="rve-title" class="text-h2 font-medium md:col-span-7" data-reveal>
          Same footage. <span class="serif text-ember">Different</span> video.
        </h2>
        <p class="max-w-[40ch] text-muted md:col-span-4 md:col-start-9 md:self-end" data-reveal style="--i:1">
          Drag the handle to compare the camera file with the finished cut — pacing, grade, captions and motion.
        </p>
      </div>

      <div class:list={['relative mt-12 md:mt-16', !real && 'ph']} data-reveal>
        {!real && <span class="ph-tag">PLACEHOLDER · demo clip · hidden in production</span>}
      <div class="compare relative aspect-video overflow-hidden rounded-lg bg-surface" data-compare style="--pos:50%">
        <video class="absolute inset-0 size-full object-cover" src={after} poster={poster} muted loop playsinline preload="none" data-compare-video aria-hidden="true" />
        <div class="compare-before absolute inset-0">
          <video
            class:list={['absolute inset-0 size-full object-cover', !real && 'raw-look']}
            src={before}
            poster={poster}
            muted
            loop
            playsinline
            preload="none"
            data-compare-video
            aria-hidden="true"
          />
        </div>
        <span class="absolute top-4 left-4 rounded-full bg-ink/60 px-3 py-1 font-mono text-label text-fg uppercase backdrop-blur-md">Raw</span>
        <span class="absolute top-4 right-4 rounded-full bg-ember px-3 py-1 font-mono text-label text-ink uppercase">Edited</span>
        <div class="compare-handle pointer-events-none absolute inset-y-0 w-px bg-fg" aria-hidden="true">
          <span class="absolute top-1/2 left-1/2 grid size-11 -translate-1/2 place-items-center rounded-full bg-fg text-ink shadow-lg">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" /></svg>
          </span>
        </div>
        <label class="sr-only" for="compare-range">Comparison position: raw on the left, edited on the right</label>
        <input id="compare-range" type="range" min="0" max="100" value="50" class="compare-range absolute inset-0 size-full cursor-ew-resize opacity-0" data-compare-range />
      </div>
      </div>
    </section>
  )
}

<style>
  .compare-before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .compare-handle {
    left: var(--pos);
  }
  .compare:has(.compare-range:focus-visible) .compare-handle span {
    outline: 2px solid var(--color-ember);
    outline-offset: 3px;
  }
  /* Dev demo only: fake a flat, ungraded camera file */
  .raw-look {
    filter: saturate(0.25) contrast(0.82) brightness(1.08);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((box) => {
    const range = box.querySelector<HTMLInputElement>('[data-compare-range]')!;
    const set = () => box.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
    // Play both clips in sync only while visible (and not under reduced motion)
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const vids = [...box.querySelectorAll<HTMLVideoElement>('[data-compare-video]')];
    new IntersectionObserver(([e]) => {
      vids.forEach((v) => {
        if (e.isIntersecting) {
          v.preload = 'auto';
          v.play().catch(() => {});
        } else v.pause();
      });
      if (e.isIntersecting && vids.length === 2) vids[1].currentTime = vids[0].currentTime;
    }, { threshold: 0.4 }).observe(box);
  });
</script>
