---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import HeroReel from '../components/HeroReel.astro';
import media from '../data/media.json';

const r = media.reel;
const heroPreload = [
  { href: r['9x16'].poster.avif, media: '(max-width: 767px)' },
  { href: r['16x9'].poster.avif, media: '(min-width: 768px)' },
];

// Stage 1 shell: layout, grid and tokens. Sections are filled in Stage 3.
const shells = [
  { id: 'trust', track: 'V0', label: 'Trust', tc: '00:00:08:00' },
  { id: 'work', track: 'V1', label: 'Selected Work', tc: '00:00:16:00' },
  { id: 'services', track: 'V2', label: 'Services', tc: '00:00:32:00' },
  { id: 'process', track: 'V3', label: 'Process', tc: '00:00:48:00' },
  { id: 'raw-vs-edited', track: 'FX', label: 'Raw vs Edited', tc: '00:01:04:00' },
  { id: 'testimonials', track: 'A1', label: 'Testimonials', tc: '00:01:16:00' },
  { id: 'tools', track: 'A2', label: 'Tools', tc: '00:01:28:00' },
  { id: 'about', track: 'A3', label: 'About', tc: '00:01:40:00' },
  { id: 'contact', track: 'OUT', label: 'Contact', tc: '00:02:10:00' },
];
---

<Base preload={heroPreload}>
  <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden pb-16 md:pb-24" aria-labelledby="hero-title">
    <HeroReel />
    <!-- Dark grade so the headline always clears AA over any frame -->
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/75 to-ink/35" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/80 via-ink/20 to-transparent" aria-hidden="true"></div>

    <div class="container-x">
      <p class="track mb-8"><span class="track-id">REC</span> Showreel — 2026</p>
      <h1 id="hero-title" class="max-w-[14ch] text-display font-medium">
        I edit videos people <span class="serif text-ember">actually</span> finish watching.
      </h1>
      <p class="mt-6 max-w-[46ch] text-lg text-muted md:text-xl">
        Long-form YouTube, talking-head and podcast edits with smooth pacing, sharp storytelling, and sound that
        holds attention.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="#work" class="btn btn-primary" data-magnetic>View Work</a>
        <a href="#contact" class="btn btn-ghost" data-magnetic>Book a Call</a>
      </div>
    </div>
  </section>

  {
    shells.map((s) => (
      <section id={s.id} class="container-x py-24 md:py-32">
        <SectionHead track={s.track} label={s.label} tc={s.tc} />
        <div class="mt-12 grid grid-cols-4 gap-4 md:grid-cols-12 md:gap-6">
          <h2 class="col-span-4 text-h2 font-medium md:col-span-7">
            {s.label} <span class="serif text-muted">section</span>
          </h2>
          <p class="col-span-4 text-muted md:col-span-4 md:col-start-9">
            Stage 1 shell. This section is built in Stage 3.
          </p>
        </div>
      </section>
    ))
  }
</Base>
