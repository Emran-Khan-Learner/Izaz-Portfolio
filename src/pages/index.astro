---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Hero from '../components/Hero.astro';
import Trust from '../components/Trust.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import RawVsEdited from '../components/RawVsEdited.astro';
import Testimonials from '../components/Testimonials.astro';
import Tools from '../components/Tools.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Lightbox from '../components/Lightbox.astro';
import Previews from '../components/Previews.astro';
import { works, featuredWorks } from '../lib/works';
import media from '../data/media.json';

const r = media.reel;
const heroPreload = [
  { href: r['9x16'].poster.avif, media: '(max-width: 767px)' },
  { href: r['16x9'].poster.avif, media: '(min-width: 768px)' },
];
---

<Base preload={heroPreload}>
  <Preloader />
  <Hero />
  <Trust />

  <section id="work" class="container-x py-24 md:py-36" aria-labelledby="work-title">
    <SectionHead track="V1" label="Selected Work" tc="00:00:16:00" />
    <div class="mt-10 mb-12 grid gap-6 md:mt-14 md:mb-16 md:grid-cols-12">
      <h2 id="work-title" class="text-h2 font-medium md:col-span-7" data-reveal>
        Cuts that <span class="serif text-muted">hold</span> attention.
      </h2>
      <p class="max-w-[40ch] text-muted md:col-span-4 md:col-start-9 md:self-end" data-reveal style="--i:1">
        Hover to preview, click to watch. Ads, talking-head and long-form edits for brands and creators.
      </p>
    </div>
    <WorkGrid works={featuredWorks} archiveLink totalCount={works.length} />
  </section>

  <Services />
  <Process />
  <RawVsEdited />
  <Testimonials />
  <Tools />
  <About />
  <Contact />

  <Lightbox />
  <Previews />
</Base>
