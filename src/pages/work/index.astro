---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import Previews from '../../components/Previews.astro';
import { works } from '../../lib/works';
import { site } from '../../data/site.mjs';
---

<Base
  title="Work"
  description={`Full archive of edits by ${site.name}: long-form YouTube, talking-head, podcast, motion graphics and short-form ads.`}
>
  <section class="container-x pt-32 pb-24 md:pt-44 md:pb-36" aria-labelledby="archive-title">
    <SectionHead track="BIN" label="Project archive" tc={`${String(works.length).padStart(2, '0')} clips`} />
    <div class="mt-10 mb-12 grid gap-6 md:mt-14 md:mb-16 md:grid-cols-12">
      <h1 id="archive-title" class="text-display font-medium md:col-span-8" data-split>
        <span class="line" style="--l:0"><span class="line-inner">All <span class="serif text-muted">work.</span></span></span>
      </h1>
      <p class="max-w-[40ch] text-muted md:col-span-4 md:self-end" data-reveal style="--i:1">
        Every project in one bin. Filter by format, hover to preview, click to watch — or open the case study.
      </p>
    </div>
    <WorkGrid works={works} />
  </section>

  <Lightbox />
  <Previews />
</Base>
