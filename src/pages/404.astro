---
/**
 * 404 — "Clip offline". An editor's empty timeline: the clip this link
 * pointed to has gone offline; relink to the home page or the archive.
 */
import Base from '../layouts/Base.astro';
---

<Base title="Clip offline" description="This page doesn't exist — the clip has gone offline." noindex>
  <section class="relative isolate flex min-h-svh items-center overflow-hidden py-32" aria-labelledby="nf-title">
    <!-- Offline "slate": diagonal hatch + a timeline with a missing clip -->
    <div class="hatch absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
    <div class="container-x">
      <p class="track mb-8">
        <span class="track-id text-ember">404</span>
        <span class="tabular-nums" data-nf-tc>00:00:00:00</span>
      </p>
      <h1 id="nf-title" class="text-display font-medium" data-split>
        <span class="line" style="--l:0"><span class="line-inner">Clip</span></span>
        <span class="line" style="--l:1"><span class="line-inner"><span class="serif text-ember">offline.</span></span></span>
      </h1>
      <p class="mt-8 max-w-[44ch] text-lg text-muted" data-intro style="--i:2">
        The media this link points to can't be found. It may have been moved, renamed, or never rendered.
      </p>

      <!-- Mini timeline with the missing clip -->
      <div class="mt-14 max-w-2xl" aria-hidden="true" data-intro style="--i:3">
        <div class="flex items-center gap-3 font-mono text-[10px] text-faint">
          <span class="w-6">V1</span>
          <div class="flex h-9 flex-1 gap-1">
            <span class="w-1/4 rounded-sm border border-line-strong bg-surface"></span>
            <span class="offline-clip flex flex-1 items-center justify-center rounded-sm border border-ember/60 font-semibold tracking-widest text-ember uppercase">Media offline</span>
            <span class="w-1/5 rounded-sm border border-line-strong bg-surface"></span>
          </div>
        </div>
        <div class="mt-1 flex items-center gap-3 font-mono text-[10px] text-faint">
          <span class="w-6">A1</span>
          <div class="h-6 flex-1 rounded-sm border border-line bg-surface/60"></div>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap gap-3" data-intro style="--i:4">
        <a href="/" class="btn btn-primary" data-magnetic>Relink to home</a>
        <a href="/work" class="btn btn-ghost" data-magnetic>Browse all work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hatch {
    background-image: repeating-linear-gradient(135deg, var(--color-line) 0 1px, transparent 1px 14px);
    mask-image: radial-gradient(80% 70% at 70% 50%, #000, transparent);
  }
  .offline-clip {
    background: repeating-linear-gradient(135deg, #ff5a1f22 0 6px, transparent 6px 12px);
  }
</style>

<script>
  // Timecode flickers between frames, like a playhead stuck on a missing clip.
  const tc = document.querySelector('[data-nf-tc]');
  if (tc && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let f = 0;
    setInterval(() => {
      f = (f + 1) % 24;
      tc.textContent = `00:00:04:${String(f).padStart(2, '0')}`;
    }, 1000 / 24);
  }
</script>
